      <overridable-settings>
        <date-options fiscal-year-start='january' start-of-week='sunday' />
        <default-date-format />
        <default-calendar-type>Gregorian</default-calendar-type>
      </overridable-settings>
      <aliases enabled='yes' />
      <column caption='OBU_' datatype='string' name='[Calculation_367887861176360960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[OBU] + &quot; - &quot; + [OBU_DESCRIPTION]' />
      </column>
      <column caption='Create HK date' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_367887861179056129]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [Calculation_413205330683498497]))' />
      </column>
      <column caption='Permitted User' datatype='integer' name='[Calculation_367887861180657666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [name (workbooks)] : COUNTD([EMPLID_AD]) }' />
      </column>
      <column caption='IsRightName' datatype='boolean' name='[Calculation_413205330682601472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[name (workbooks)] = [Parameters].[Name (Workbooks) Parameter]' />
      </column>
      <column caption='Created At HK' datatype='datetime' name='[Calculation_413205330683498497]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;hour&apos;, 8, [historical_event_created_at])' />
      </column>
      <column caption='Count Distinct Days' datatype='integer' name='[Calculation_413205330688696323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(DATETRUNC(&apos;day&apos;, [Calculation_413205330683498497]))' />
      </column>
      <column caption='Last View' datatype='string' name='[Calculation_413205330690650120]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;  RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, MAX([Calculation_413205330683498497]))), 2) + &quot;-&quot; + &#13;&#10;  RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, MAX([Calculation_413205330683498497]))), 2) + &quot;-&quot; + &#13;&#10;  STR(DATEPART(&apos;year&apos;, MAX([Calculation_413205330683498497]))) + &quot; &quot; +&#13;&#10;  RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, MAX([Calculation_413205330683498497]))), 2) + &quot;:&quot; +&#13;&#10;  RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, MAX([Calculation_413205330683498497]))), 2),&#13;&#10;&apos;-&apos;)' />
      </column>
