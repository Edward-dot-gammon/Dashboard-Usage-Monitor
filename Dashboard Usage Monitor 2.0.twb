      <column caption='Total Views' datatype='integer' name='[Calculation_413205330691506186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;  IF NOT ISNULL([Calculation_413205330683498497]) &#13;&#10;  THEN [NAME] &#13;&#10;  END&#13;&#10;)' />
      </column>
      <column caption='Unique Views Per Month' datatype='integer' name='[Calculation_413205330694778891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [Calculation_413205330683498497]) :&#13;&#10;  COUNTD(&#13;&#10;    IF [name (workbooks)] = [Parameters].[Name (Workbooks) Parameter]&#13;&#10;    THEN [NAME]&#13;&#10;    END&#13;&#10;  )&#13;&#10;}' />
